# LiveKit 本地开发配置 (与 livekit.yaml 严格匹配)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_livekit_key_for_development_32chars_ok

# Google Gemini API 凭证 (请在此填入您的 Google API Key)
# 获取地址: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Gemini Live 模型配置 (可选默认)
# 支持: gemini-2.5-flash-native-audio-preview-12-2025, gemini-3.8-live
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Puck
